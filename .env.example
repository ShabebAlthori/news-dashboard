# ---------------------------------------------------------------------------
# Briefing / الموجز — configuration (copy to .env.local for `npm run dev`,
# or to .env for Docker Compose). Every variable is optional.
# All values stay on the server; nothing here is sent to the browser.
# ---------------------------------------------------------------------------

# --- Storage -----------------------------------------------------------------
# SQLite database file (articles, clusters, saved stories, settings).
DATABASE_PATH=./data/news.db

# --- Updates -----------------------------------------------------------------
# Default refresh interval in minutes (10–15). Can also be changed in Settings.
REFRESH_INTERVAL_MINUTES=12
# Set to true if you run the scheduler elsewhere (`npm run worker` or an external cron).
DISABLE_SCHEDULER=false
# Lets an external scheduler call: POST /api/refresh  with  "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional contact URL/email added to the feed fetcher's User-Agent (good netiquette).
FETCH_CONTACT=

# --- AI summaries & Arabic translation ----------------------------------------
# anthropic | gemini | ollama | none
# (empty = anthropic if ANTHROPIC_API_KEY is set, else gemini if GEMINI_API_KEY is set, else none)
AI_PROVIDER=
# Claude (recommended for natural Arabic). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default model. claude-haiku-5-5 costs far less per story; see README "Costs".
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — summarization is simple, so "low" is the default.
ANTHROPIC_EFFORT=low
# Server-side refusal fallbacks for supported models ("off" to disable).
ANTHROPIC_FALLBACKS=default
# Free option: Google Gemini API free tier. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy or its free daily quota is used up.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
# Free local alternative: https://ollama.com  (e.g. `ollama pull qwen2.5:7b-instruct`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Cost/throughput guards: stories summarized per refresh and per 24 hours.
AI_MAX_ARTICLES_PER_RUN=30
AI_DAILY_LIMIT=200
AI_CONCURRENCY=3

# --- Access control ----------------------------------------------------------
# If both are set, the whole dashboard requires HTTP Basic authentication.
# Strongly recommended whenever the app is reachable from the internet (use HTTPS).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
